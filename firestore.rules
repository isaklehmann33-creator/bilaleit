rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Stjórnandi = eigandi síðunnar (sama auðkenni og window.ADMIN_UID í firebase-config.js)
    function isAdmin() { return request.auth != null && request.auth.uid == 'bbalHMP0dtRWhU1dGsKQXUN8h2k2'; }

    // Stillingar síðunnar: allir lesa, bara stjórnandi skrifar (t.d. „uppfæra allar opnar síður“)
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Nafnlaus heimsóknatalning: hver sem er má hækka teljara dagsins um 1, bara stjórnandi les
    function step(f) {
      return request.resource.data.get(f, 0) - (resource == null ? 0 : resource.data.get(f, 0)) in [0, 1];
    }
    match /stats/{day} {
      allow read: if isAdmin();
      allow create, update: if day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
                            && request.resource.data.keys().hasOnly(['v', 'u', 'm', 'd'])
                            && step('v') && step('u') && step('m') && step('d');
    }

    // Hver notandi á eitt skjal með vistuðum bílum, leitum og tilkynningum
    match /users/{uid} {
      allow read, delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['email', 'created', 'lastSeen', 'saved', 'searches', 'notes', 'watch']);
    }
  }
}
